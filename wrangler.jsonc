{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fundlens",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "build": {
    "command": "mkdir -p dist/portfolio-fit && cp index.html dist/index.html && cp case-study/portfolio-fit/index.html dist/portfolio-fit/index.html"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
